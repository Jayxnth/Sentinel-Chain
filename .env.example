GOOGLE_API_KEY="your_key"
DATABASE_URL="your_database_url"
API_KEY="your_api_key"

# Optional: Gemini model override. Default is gemini-2.5-flash.
# Use gemini-flash-latest if your API key does not support 2.5.
GEMINI_MODEL=gemini-2.5-flash

# Streamlit dashboard defaults. The sidebar can override both values.
SENTINEL_API_URL=http://localhost:8000
SENTINEL_API_KEY=your_api_key
SENTINEL_DATA_SOURCE=Live
SENTINEL_UI_THEME=Dark
